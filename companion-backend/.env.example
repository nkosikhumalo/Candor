# Local Java service sends signup OTPs. Keep this file private; use .env for real values.
GMAIL_USER=your-email@gmail.com
# Spaces in the Gmail app password are okay; the Java sender removes them.
GMAIL_PASS=your-gmail-app-password
EMAIL_OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Use the same Upstash Redis connection URL as companion-backend-node.
REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379
