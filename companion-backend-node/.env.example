# Node.js BFF
PORT=5000

# Supabase PostgreSQL connection string. Keep this secret and do not commit .env.
# Get your connection string from Supabase dashboard → Settings → Database → Connection pooling
DATABASE_URL=postgresql://postgres:password@host/database?sslmode=require
DATABASE_SSL=true

# Java Spring Boot microservice
# Local default; on Render set this to https://medicare1-mxqs.onrender.com
JAVA_SERVICE_URL=http://localhost:8080

# Exact browser origins allowed to use the BFF. Set the production list on Render.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
TURNSTILE_SECRET_KEY=your_private_turnstile_secret_key

# Must match Java's MOCK_JWT_SIGNING_SECRET exactly.
JWT_SECRET=replace_with_a_shared_local_secret
MOCK_JWT_SIGNING_SECRET=replace_with_a_shared_local_secret

# Optional AI fallback configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_GATEWAY_VIRTUAL_KEY=
